{
	"name": "gifsicle",
	"version": "7.2.1",
	"description": "gifsicle wrapper that makes it seamlessly available as a local dependency",
	"license": "MIT",
	"repository": "PruvoNet/gifsicle-bin",
	"type": "module",
	"exports": "./index.js",
	"funding": {
		"url": "https://github.com/imagemin/gisicle-bin?sponsor=1"
	},
	"bin": {
		"gifsicle": "cli.js"
	},
	"engines": {
		"node": ">=18"
	},
	"binary": {
		"host": "https://github.com",
		"remote_path": "PruvoNet/gifsicle-bin/releases/download/v{version}"
	},
	"scripts": {
		"postinstall": "node lib/install.js",
		"test": "ava --timeout=60s"
	},
	"files": [
		"index.js",
		"cli.js",
		"lib",
		"vendor/source"
	],
	"keywords": [
		"imagemin",
		"gif",
		"img",
		"image",
		"compress",
		"minify",
		"optimize",
		"gifsicle"
	],
	"dependencies": {
		"bin-build": "^3.0.0"
	},
	"devDependencies": {
		"ava": "^6.0.0",
		"tempy": "^3.0.0"
	}
}
